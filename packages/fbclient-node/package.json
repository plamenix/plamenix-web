{
  "name": "@plamenix/fbclient-node",
  "version": "1.0.0-beta.0",
  "description": "NAPI bindings to rsfbclient for Node.js — Plamenix web edition driver.",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "license": "(MIT OR Apache-2.0)",
  "author": "Zlatan Omerović <zlomerovic@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zlatan/plamenix-web.git",
    "directory": "packages/fbclient-node"
  },
  "engines": {
    "node": ">=24"
  },
  "napi": {
    "name": "plamenix-fbclient",
    "triples": {
      "defaults": true,
      "additional": [
        "x86_64-unknown-linux-musl",
        "aarch64-unknown-linux-gnu",
        "aarch64-apple-darwin"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "dev": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ]
}
