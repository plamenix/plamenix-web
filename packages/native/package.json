{
  "name": "@plamenix/native",
  "version": "1.0.0-beta",
  "description": "NAPI bindings for the Plamenix web edition: the Firebird driver and the WASM plugin host, in one native module so they share one driver instance.",
  "main": "index.js",
  "types": "index.d.ts",
  "type": "commonjs",
  "license": "(MIT OR Apache-2.0)",
  "author": "Zlatan Omerovi\u0107 <zlomerovic@hotmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zlatan/plamenix-web.git",
    "directory": "packages/native"
  },
  "engines": {
    "node": ">=24"
  },
  "napi": {
    "binaryName": "plamenix-native",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "node --test test/*.test.js",
    "typecheck": "tsc --noEmit",
    "dev": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.0.0",
    "typescript": "^6.0.3"
  },
  "files": [
    "index.js",
    "index.d.ts"
  ]
}
